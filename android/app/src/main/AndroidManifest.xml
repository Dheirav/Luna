<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission, deliberately and permanently. The app cannot phone home
         even if a dependency tries. That is the whole reason to build your own tracker. -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required by BiometricPrompt and BiometricManager.canAuthenticate(). Normal permission,
         granted at install with no runtime prompt. Declared here rather than inherited from
         androidx.biometric, which this app deliberately does not depend on — the framework API
         covers minSdk 31 and the AndroidX wrapper costs ~1.4 MB via androidx.fragment. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Requested only via the settings screen, never silently. Vendor ROMs kill background
         work, and the daily reminder is the entire adherence mechanism. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".CycleTrackerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CycleTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CycleTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported because the launcher and the system send it broadcasts. It reads no intent
            data and takes no parameters — every path recomputes from the local database — so
            there is nothing an arbitrary sender can influence beyond forcing a redraw.
        -->
        <receiver
            android:name=".widget.CycleWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- The mood face. Separate provider so it can be placed independently of the cycle widget,
             and so its tendency can refresh at midnight without touching the other one. -->
        <receiver
            android:name=".widget.MoodWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_info" />
        </receiver>

        <!-- Not exported: only this app's own notification actions target it, and an exported
             receiver here would let any app write to the cycle log. -->
        <!-- "Log today" in Quick Settings. Says only whether today is logged; see LogTileService. -->
        <service
            android:name=".tile.LogTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Log today"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".reminder.LogActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
            Lets the share sheet read the doctor-summary PDF, and nothing else. Not exported: access
            is granted per share, to the one file, for as long as the receiving app needs it. The
            only path it covers is the cache folder the summary is written to, which the app empties
            before each new summary so no older copy lingers.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/summary_paths" />
        </provider>
    </application>
</manifest>
