<?xml version="1.0" encoding="utf-8"?>
<!-- Health data never leaves the device via cloud backup or device transfer.
     Phase 2 adds an explicit encrypted export the user initiates themselves. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
