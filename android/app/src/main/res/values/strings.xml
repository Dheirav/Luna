<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Luna</string>
    <!-- Shown in the launcher's widget picker. Deliberately vague about what it tracks — the
         picker is browsed in public as readily as the home screen is seen. -->
    <string name="widget_description">Today at a glance, and a one-tap shortcut to log.</string>
    <!-- Same discretion as above: says nothing about cycles, and says "logged" rather than "feel",
         because that is what it shows. -->
    <string name="mood_widget_description">A face for what you have logged, and a tap to log more.</string>
    <string name="next_widget_description">When your next period is expected, as a range of days.</string>
    <!-- Widget names in the picker. All three read "Luna" before, so none could be told apart. -->
    <string name="widget_label_log">Log today</string>
    <string name="widget_label_mood">How are you</string>
    <string name="widget_label_next">Next period</string>
</resources>
