<?xml version="1.0" encoding="utf-8"?>
<!--
    The whole widget is one tap target, and the tap goes straight to the log form rather than the
    app's front door. That is the entire justification for the widget existing: the reminder has
    never been proven to survive either test phone's ROM, and a widget needs no background
    execution to stay on screen.

    **Only allow-listed views here (LinearLayout, TextView, ImageView), and that is a hard
    constraint, not a style choice.**
    RemoteViews inflates in the launcher's process and accepts only an allow-listed set of view
    classes — those annotated `@RemoteView`. An earlier version used `Space` to push the action
    line to the bottom and `android:theme` on the root; neither is permitted, and the launcher
    reports the failure as a flat "Can't load widget" with no clue as to which line caused it.

    So: no `Space` (a weighted TextView does the same job), no `android:theme`, no custom views.
    Before adding anything here, check it is annotated `@RemoteView` in the framework.

    **Two lines, not four.** This was a 3×2 widget with a DAY eyebrow, a large phase name, a detail
    line and an action line. At one cell tall there is room for about 40dp of text, so the eyebrow
    is folded into the headline ("Day 16 · Luteal") and the action line is gone — it read "Tap to
    log today", which is instruction rather than information, and the whole widget was already the
    tap target. What the action line uniquely carried, whether today is logged, moved into the
    detail line as a tick, because that is the one question this widget exists to answer quickly.

    **3x1, after 2x1 was tried and rejected.** At two cells the longest headline the app can produce,
    "Day 16 · Follicular", clipped to "Day 16 · Follicu…". That was defensible — visible truncation
    beats silently dropping the window date or the tick — but three cells costs one grid column and
    nothing clips at all, which is plainly better than choosing which compromise to accept.

    `minWidth` stays at 110dp regardless, so anyone who wants it narrower can drag it there and take
    the ellipsis knowingly. A default should not force that trade on someone who never asked for it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Day 16 · Luteal" />

        <!-- The main text colour, not the muted one: this line sits on the phase tint, where the muted
             grey measured 3.7:1 on the pinks and lilacs (council review A3). Size keeps it secondary. -->
        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Next 1–9 Jan" />
    </LinearLayout>

    <!-- One-tap answers, shown only while today's bleeding question is unanswered: a filled dot for
         bleeding and an empty one for none, the calendar's own marks, and no words, so the home
         screen does not say what the app tracks. The spoken labels do say it, for whoever is using
         the phone. 40dp each, so the touch target is generous though the dot is small. -->
    <LinearLayout
        android:id="@+id/widget_answers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_answer_bleeding"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/widget_dot_filled"
            android:contentDescription="Log bleeding today" />

        <ImageView
            android:id="@+id/widget_answer_none"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/widget_dot_empty"
            android:contentDescription="Log no bleeding today" />
    </LinearLayout>

    <!-- The app's cloud, so the widget looks like Luna rather than a system tile (8 Oct 2026). It
         carries nothing about the person: always the resting face, even in detail mode. Shown once
         today is answered, in place of the dots. -->
    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="40dp"
        android:layout_height="29dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mascot" />
</LinearLayout>
