<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground: a soft petal bloom with a sparkle, matching the in-app palette.

    A vector rather than the usual five PNG densities — a few hundred bytes instead of tens of
    kilobytes, and sharp on any screen.

    Adaptive icons crop to a circle on most launchers and the outer ~18% of each edge can be
    shaved off entirely, so everything meaningful is kept inside the middle 66dp of the 108dp
    canvas. The petals reach to roughly r=26 from centre, which survives every mask shape.

    Deliberately not a droplet or a calendar. This sits on a home screen other people can see,
    and an icon that announces what it tracks is a privacy leak the app otherwise works hard to
    avoid — the same reasoning behind FLAG_SECURE on the recents thumbnail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four petals, each a teardrop meeting at the centre. -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path
            android:fillColor="#E86A93"
            android:pathData="M54,28 C62,36 62,46 54,54 C46,46 46,36 54,28 Z" />
        <path
            android:fillColor="#E86A93"
            android:pathData="M80,54 C72,62 62,62 54,54 C62,46 72,46 80,54 Z" />
        <path
            android:fillColor="#D9558A"
            android:pathData="M54,80 C46,72 46,62 54,54 C62,62 62,72 54,80 Z" />
        <path
            android:fillColor="#D9558A"
            android:pathData="M28,54 C36,46 46,46 54,54 C46,62 36,62 28,54 Z" />
    </group>

    <!-- Diagonal petals, lighter so the bloom reads as layered rather than as an eight-point star. -->
    <path
        android:fillColor="#F3A8C4"
        android:pathData="M72,36 C72,47 66,53 55,53 C55,42 61,36 72,36 Z" />
    <path
        android:fillColor="#F3A8C4"
        android:pathData="M36,72 C36,61 42,55 53,55 C53,66 47,72 36,72 Z" />

    <!-- Centre. -->
    <path
        android:fillColor="#FBEFCF"
        android:pathData="M54,49 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- The same four-point sparkle used in-app, top right, inside the safe zone. -->
    <path
        android:fillColor="#F0C978"
        android:pathData="M76,26 C77,30 78,31 82,32 C78,33 77,34 76,38 C75,34 74,33 70,32 C74,31 75,30 76,26 Z" />
</vector>
