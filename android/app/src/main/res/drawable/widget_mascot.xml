<?xml version="1.0" encoding="utf-8"?>
<!--
    The cloud mascot for the home-screen widget: the same character as Today's hero, drawn as a
    vector because RemoteViews cannot run Compose. Resting face only. On Today the face follows the
    mood logged today, but a widget is visible to anyone who glances at the home screen and the
    discreet mode promises nothing about the person shows there, so the widget's cloud never reacts.

    Colours come from widget_mascot_* so the light and dark variants match the app's own (white with
    a violet face and a soft shadow in light; cream with a plum face in dark). Geometry mirrors
    MascotCloud in Decor.kt: three circles on a rounded base, on a 78 by 56 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="29dp"
    android:viewportWidth="78"
    android:viewportHeight="56">

    <!-- Shadow: a flattened oval under the base. Transparent in dark mode. -->
    <path
        android:fillColor="@color/widget_mascot_shadow"
        android:pathData="M12.5,50.5 a26.5,4 0 1,0 53,0 a26.5,4 0 1,0 -53,0 Z" />

    <!-- Body -->
    <path
        android:fillColor="@color/widget_mascot_body"
        android:pathData="M-0.3,33.6 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" />
    <path
        android:fillColor="@color/widget_mascot_body"
        android:pathData="M44,34.7 a16.8,16.8 0 1,0 33.6,0 a16.8,16.8 0 1,0 -33.6,0 Z" />
    <path
        android:fillColor="@color/widget_mascot_body"
        android:pathData="M14.4,26.9 a24.6,24.6 0 1,0 49.2,0 a24.6,24.6 0 1,0 -49.2,0 Z" />
    <path
        android:fillColor="@color/widget_mascot_body"
        android:pathData="M20.6,29.1 H57.4 A11.2,11.2 0 0,1 57.4,51.5 H20.6 A11.2,11.2 0 0,1 20.6,29.1 Z" />

    <!-- Blush, then eyes and a level mouth: resting, never a claim about how anyone feels. -->
    <path
        android:fillColor="#73E86A93"
        android:pathData="M17,34.2 a4.8,4.8 0 1,0 9.6,0 a4.8,4.8 0 1,0 -9.6,0 Z" />
    <path
        android:fillColor="#73E86A93"
        android:pathData="M51.4,34.2 a4.8,4.8 0 1,0 9.6,0 a4.8,4.8 0 1,0 -9.6,0 Z" />
    <path
        android:fillColor="@color/widget_mascot_face"
        android:pathData="M26.5,28 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0 Z" />
    <path
        android:fillColor="@color/widget_mascot_face"
        android:pathData="M45.3,28 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0 Z" />
    <path
        android:strokeColor="@color/widget_mascot_face"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M35.5,36 L42.5,36" />
</vector>
