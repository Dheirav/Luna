<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icon: the bloom from the launcher icon, reduced to a silhouette.

    Replaces `android.R.drawable.ic_dialog_info`, which was a full-colour framework drawable.
    **Android discards the colours of a notification small icon and keeps only its alpha channel**,
    so that one rendered as a solid disc — it read as a stop sign in the status bar, which is both
    wrong and alarming for a cycle reminder.

    Consequences of that rule, and the reasons this file looks the way it does:

    - Every fill is opaque white. The system applies its own tint (and `setColor` supplies the accent
      in the shade), so any colour here would be thrown away. Do not add a palette.
    - It cannot have a background. A filled backdrop becomes a solid block once flattened, which is
      the same failure as before.
    - Nothing subtle survives. The launcher icon's lighter diagonal petals and its sparkle are
      omitted: with colour gone they merge into the four main petals and turn an 18dp bloom into a
      blob. Four petals meeting at the centre is as much detail as this size carries.

    Deliberately a bloom rather than a droplet or a calendar, for the reason the launcher icon is —
    the status bar is visible to anyone glancing at the phone, and an icon that announces what the
    app tracks undoes the discretion the rest of the app is careful about.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Four petals, each a teardrop meeting at the centre. Reach r=9 of a 24 canvas: large enough
         to read, with the ~2dp margin the status bar expects on every side. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3 C15,6.5 15,9.5 12,12 C9,9.5 9,6.5 12,3 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21,12 C17.5,15 14.5,15 12,12 C14.5,9 17.5,9 21,12 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,21 C9,17.5 9,14.5 12,12 C15,14.5 15,17.5 12,21 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,12 C6.5,9 9.5,9 12,12 C9.5,15 6.5,15 3,12 Z" />
</vector>
